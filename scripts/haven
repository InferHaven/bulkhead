#!/bin/bash
# haven: the CLI's old name. It prints one notice on stderr and then runs
# ./scripts/bulkhead with the same arguments, so existing scripts keep working.
# BULKHEAD_RENAME_NOTICE=0 silences the notice.
[ "${BULKHEAD_RENAME_NOTICE:-1}" = 0 ] || echo "This command is now 'bulkhead' (short: 'bh'). 'haven' still works." >&2
exec "$(dirname "$0")/bulkhead" "$@"
